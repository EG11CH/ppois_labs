PROJECT_NAME           = "Лабораторная №1: словарь и множество"
PROJECT_NUMBER         = 1.0
OUTPUT_DIRECTORY       = "@CMAKE_CURRENT_BINARY_DIR@/documentation"
INPUT                  = "@CMAKE_CURRENT_SOURCE_DIR@/include" "@CMAKE_CURRENT_SOURCE_DIR@/docs/mainpage.dox"
RECURSIVE              = YES
FILE_PATTERNS          = *.h *.dox
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
OUTPUT_LANGUAGE        = English
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HAVE_DOT               = NO
WARN_AS_ERROR          = YES
QUIET                  = YES
